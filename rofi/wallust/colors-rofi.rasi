 /* wallust template - colors-rofi */

* {
active-background: #545F48;
active-foreground: #D0E0E9;
normal-background: #1B1D1B;
normal-foreground: #D0E0E9;
urgent-background: #B6645A;
urgent-foreground: #D0E0E9;

alternate-active-background: #381C1C;
alternate-active-foreground: #D0E0E9;
alternate-normal-background: #1B1D1B;
alternate-normal-foreground: #D0E0E9;
alternate-urgent-background: #1B1D1B;
alternate-urgent-foreground: #D0E0E9;

selected-active-background: #545F48;
selected-active-foreground: #1B1D1B;
selected-normal-background: #545F48;
selected-normal-foreground: #1B1D1B;
selected-urgent-background: #381C1C;
selected-urgent-foreground: #1B1D1B;

background-color: #1B1D1B;
background: rgba(0,0,0,0.7);
foreground: #D0E0E9;
border-color: #545F48;

color0: #424441;
color1: #12170F;
color2: #241613;
color3: #2A1515;
color4: #3F4736;
color5: #884B43;
color6: #5A7C90;
color7: #B3CAD7;
color8: #7D8D97;
color9: #181F14;
color10: #2F1D1A;
